JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ADMIN_DEFAULT_PASSWORD=change-this-before-first-run
NODE_ENV=development

# Smart Contract (set after deploying BoldGainsWallet.sol)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Hardhat deployment wallet (never commit the real value)
DEPLOYER_PRIVATE_KEY=

# Operator wallet = the private key of the contract owner address.
# Used server-side to call batchPayout() for instant bonus distribution.
# Use a DEDICATED wallet — not your personal wallet. Never commit this.
OPERATOR_PRIVATE_KEY=

# Pool wallet addresses (BSC)
PRODUCTS_POOL_ADDRESS=
LEADERSHIP_POOL_ADDRESS=
RANK_POOL_ADDRESS=

# Optional: BSC Scan API key for contract verification
BSCSCAN_API_KEY=
